# Copy this file to .env.local and fill in real values from your Supabase
# project's Settings -> API page. .env.local is gitignored, so real secrets
# never get committed.

# Safe to expose in the browser (RLS restricts it to read-only access).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only -- never prefix this with NEXT_PUBLIC_, and never reference it
# from client-side code. It bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
